# Copy to .env and adjust. Never commit .env (it is in .gitignore).

# --- General ------------------------------------------------------------------------------------
# Port on the Docker host
DASHBOARD_PORT=8080
# true = synthetic demo data, no Proxmox needed
PVE_MOCK=false
# Seconds between polls of /cluster/resources (5-10 recommended)
POLL_INTERVAL=10
# Seconds between polls of /nodes/<node>/status (load, IO delay, kernel ...)
NODE_STATUS_INTERVAL=30
# Global safety switch: true = no control actions at all (start/stop/snapshot/...)
READ_ONLY=true
# true = actions are checked and written to the audit log, but NOT sent to Proxmox
DRY_RUN=false
LOG_LEVEL=INFO

# --- Login & security ---------------------------------------------------------------------------
# First start without users creates this admin. Empty password = random, printed ONCE to the
# container log (docker compose logs dashboard) and must be changed at the first login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# Roles that must use TOTP (comma separated, empty = optional for all)
TOTP_REQUIRED_ROLES=admin,operator
# Session lifetime and idle timeout
SESSION_MAX_HOURS=12
SESSION_IDLE_MINUTES=120
# Cookie "Secure" flag: auto = when the request came in via HTTPS (also behind a proxy)
COOKIE_SECURE=auto
# Encrypts TOTP secrets. Empty = generated and stored in the data volume (/data/secret.key).
APP_SECRET_KEY=
# IP of your reverse proxy, so the real client IP is used for rate limiting and the audit log
FORWARDED_ALLOW_IPS=127.0.0.1
# Public URL of the dashboard (links in alert notifications)
DASHBOARD_URL=
# /metrics without API key (only if the port is not reachable from untrusted networks)
METRICS_PUBLIC=false

# --- Node management via SSH (upgrades, mainboard, temperatures) --------------------------------
# User created by deploy/node-setup.sh on every node
SSH_USER=pve-dashboard
SSH_PORT=22
# Seconds between reading the list of available updates
UPDATE_CHECK_INTERVAL=21600
# Seconds between temperature reads (0 = off)
SENSORS_INTERVAL=60

# --- History (VictoriaMetrics) ------------------------------------------------------------------
# Set by docker-compose to the bundled container; override to use an external instance.
#VM_URL=http://victoriametrics:8428
# How long history is kept (VictoriaMetrics retention)
VM_RETENTION=400d
# Mock mode only: fill an empty TSDB with 30 days of synthetic history
MOCK_BACKFILL=true
# Seconds between inventory runs (disks, NICs, PCI, guest configs)
INVENTORY_INTERVAL=900

# --- Clusters -----------------------------------------------------------------------------------
# Numbered groups PVE_<n>_*. Add PVE_2_*, PVE_3_* ... for more clusters or standalone hosts.
PVE_1_NAME=homelab
# Comma-separated: the dashboard fails over to the next node if one is down
PVE_1_URLS=https://pve1.lan:8006,https://pve2.lan:8006,https://pve3.lan:8006
PVE_1_TOKEN_ID=dashboard@pve!readonly
PVE_1_TOKEN_SECRET=00000000-0000-0000-0000-000000000000
# Keep true. For self-signed certs prefer PVE_1_CA_FILE (copy /etc/pve/pve-root-ca.pem to ./certs/)
PVE_1_VERIFY_TLS=true
#PVE_1_CA_FILE=/certs/pve-root-ca.pem
# Base URL for console links if it differs from the first API URL
#PVE_1_WEB_URL=https://pve.lan:8006
# Second token with the Dashboard-Operator role (bash deploy/pve-setup-roles.sh --operator).
# Without it, the dashboard stays read-only for this cluster.
#PVE_1_OPERATOR_TOKEN_ID=dashboard@pve!operator
#PVE_1_OPERATOR_TOKEN_SECRET=
# Third token with Dashboard-NodeAdmin (bash deploy/pve-setup-roles.sh --node-admin):
# list/refresh updates (Proxmox requires Sys.Modify even for listing), changelog, node reboot.
#PVE_1_NODEADMIN_TOKEN_ID=dashboard@pve!nodeadmin
#PVE_1_NODEADMIN_TOKEN_SECRET=
# SSH addresses if they differ from the cluster network IPs
#PVE_1_SSH_HOSTS=pve1=192.168.10.11,pve2=192.168.10.12,pve3=192.168.10.13
#PVE_1_TIMEOUT=10

# --- Optional: OIDC single sign-on (Authentik, Keycloak, ...) -----------------------------------
# Redirect URI to register at the IdP: <DASHBOARD_URL>/api/v1/auth/oidc/callback
#OIDC_ISSUER=https://auth.example.com/application/o/pve-dashboard/
#OIDC_CLIENT_ID=
#OIDC_CLIENT_SECRET=
#OIDC_SCOPES=openid profile email groups
#OIDC_ADMIN_GROUPS=pve-admins
#OIDC_OPERATOR_GROUPS=pve-operators
# Empty = every IdP user may log in as viewer; set to restrict
#OIDC_VIEWER_GROUPS=pve-viewers
#OIDC_BUTTON_LABEL=Mit Authentik anmelden
#OIDC_LINK_EXISTING=false

# --- Backups ------------------------------------------------------------------------------------
# A guest counts as backed up if its newest backup is younger than this
BACKUP_MAX_AGE_HOURS=48
BACKUP_REFRESH_INTERVAL=900

# --- Optional: package updates inside guests (Debian/Ubuntu; VMs via guest agent, LXC via SSH) --
# Needs: bash deploy/pve-setup-roles.sh --operator --guest-updates  (VM.GuestAgent.Unrestricted)
GUEST_UPDATES=false

# --- Optional: MCP server (docker compose --profile mcp up -d) ----------------------------------
# API key from Admin → API-Keys (scope read, or control to allow actions)
#MCP_DASHBOARD_API_KEY=pvd_...
# Shared secret MCP clients send as "Authorization: Bearer <token>" (min. 24 chars):
#   openssl rand -base64 32
#MCP_AUTH_TOKEN=
#MCP_PORT=8765
